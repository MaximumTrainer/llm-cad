# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
# The LLM integration tests read these from the environment:
#
#   uv run pytest -m llm -v

# Required for tests/test_llm_integration.py. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Must support BOTH tool calling and image input.
# Default: anthropic/claude-sonnet-5 (used by the SPEC 9.1 acceptance test)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Optional. OpenRouter bills against the requested max_tokens, so a small
# balance needs a small cap here. Default: 2048
# OPENROUTER_MAX_TOKENS=2048

# Set to 1 to run the full paid SPEC 9.1 design loop.
# CAD_MCP_LLM_ACCEPTANCE=1

# Required only for the Meshy gen_ai_mesh integration tests (SPEC 10.2).
# MESHY_API_KEY=msy_...
